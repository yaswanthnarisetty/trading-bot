# ── Server ─────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/options-bot-mvp1

# ── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Kite Connect ───────────────────────────────────────────
# Get API key + secret from: https://developers.kite.trade → My Apps
# ⚠️  Access token expires at midnight IST every day.
# To refresh: visit https://kite.trade/connect/login?api_key=YOUR_KEY
# Copy the request_token from the redirect URL, then call:
#   POST /api/kite/refresh  { "requestToken": "<request_token>" }
# The server will compute the checksum, exchange the token, and save it here.
KITE_API_KEY=
# API Secret — used to compute SHA256 checksum for access token generation
KITE_API_SECRET=your_api_secret_here
KITE_ACCESS_TOKEN=

# Instrument tokens for NSE index historical candles.
# These are fixed values — override only if NSE reassigns them.
# NIFTY 50:         256265
# NIFTY BANK:       260105
# NIFTY FIN SERVICE: 257801
KITE_NIFTY_INSTRUMENT_TOKEN=256265
KITE_BANKNIFTY_INSTRUMENT_TOKEN=260105
KITE_FINNIFTY_INSTRUMENT_TOKEN=257801

# ── News API (leave blank for mock sentiment) ──────────────
# Free tier at: https://newsapi.org
NEWSAPI_KEY=

# ── Trading Config ─────────────────────────────────────────
TRADING_PHASE=1
PAPER_CAPITAL=50000
MIN_CONFIDENCE=0.65
MAX_POSITIONS=3
MAX_DAILY_LOSS_PCT=2
RISK_FREE_RATE=6.5
